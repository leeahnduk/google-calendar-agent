# =============================================================================
# Google Cloud Configuration
# =============================================================================

# Your Google Cloud Project ID (from gcloud config get-value project)
GOOGLE_CLOUD_PROJECT=your-project-id

# Your Google Cloud Project Number (get with: gcloud projects describe PROJECT_ID --format="value(projectNumber)")
GOOGLE_CLOUD_PROJECT_NUMBER=123456789012

# Google Cloud region (us-central1 recommended for Vertex AI)
GOOGLE_CLOUD_LOCATION=us-central1

# Google Cloud Storage staging bucket for agent deployments (must be globally unique)
STAGING_BUCKET=gs://your-unique-bucket-name-meeting-agent-staging

# =============================================================================
# Multi-Agent System Configuration
# =============================================================================

# Display name for the multi-agent system (will appear in AgentSpace)
AGENT_DISPLAY_NAME=Meeting_Prep_Agent_Multi

# OAuth authorization ID (create a unique identifier for your deployment)
AUTH_ID=meeting-prep-multi-auth-v1

# =============================================================================
# AgentSpace Configuration (will be filled after initial deployment)
# =============================================================================

# AgentSpace app/engine ID (leave empty initially, filled by create_agent.sh script)
AS_APP=

# Assistant ID within the AgentSpace app (usually "default_assistant")
ASSISTANT_ID=default_assistant

# Internal agent name (lowercase, hyphens, no spaces)
AGENT_NAME=meeting-prep-multi-agent

# Agent description for AgentSpace
AGENT_DESCRIPTION="Multi-agent system for comprehensive meeting preparation with smart routing"

# Tool description for AgentSpace
TOOL_DESCRIPTION="Specialized agents for meeting briefs, details, search, export, and scheduling"

# Reasoning engine resource name (set after deploying with meeting_prep_agent_multi.py)
REASONING_ENGINE=

# =============================================================================
# AI Model Configuration
# =============================================================================

# Primary agent AI model
ROOT_AGENT_MODEL=gemini-2.5-flash

# Sub-agent AI model
SUB_AGENT_MODEL=gemini-2.5-flash

# =============================================================================
# Agent Behavior Settings
# =============================================================================

# Minutes before meeting start to prepare brief
BRIEF_LEAD_MINUTES=30

# Days to look back for historical meeting context
HISTORICAL_LOOKBACK_DAYS=90

# =============================================================================
# Chat Integration Preferences
# =============================================================================

# Enable Google Chat integration
GOOGLE_CHAT_ENABLED=true

# Chat integration preference: "slack", "google_chat", or "both"
CHAT_INTEGRATION_PREFERENCE=both

# =============================================================================
# Optional: Slack Integration
# =============================================================================

# Slack bot token (optional, for Slack integration)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Slack signing secret (optional, for Slack integration)
SLACK_SIGNING_SECRET=your-slack-signing-secret

# =============================================================================
# OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
# =============================================================================

# Google OAuth 2.0 Client ID (from OAuth client creation step)
CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret (from OAuth client creation step)
CLIENT_SECRET=your-client-secret

# OAuth 2.0 scopes (space-separated, required for AgentSpace authorization)
# All these scopes must be added to your OAuth consent screen
SCOPES="https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/chat.spaces.readonly https://www.googleapis.com/auth/chat.messages.readonly https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/documents"

# =============================================================================
# Multi-Agent Deployment Instructions
# =============================================================================

# 1. Copy this file to .env and fill in your values:
#    cp .env.example .env

# 2. Enable required Google Cloud APIs:
#    gcloud services enable calendar-json.googleapis.com drive.googleapis.com discoveryengine.googleapis.com aiplatform.googleapis.com oauth2.googleapis.com gmail.googleapis.com chat.googleapis.com docs.googleapis.com

# 3. Create OAuth 2.0 credentials in Google Cloud Console (see deployment_guide.md for details)

# 4. Deploy the multi-agent reasoning engine:
#    export PYTHONPATH=$(pwd):$PYTHONPATH
#    python agents/meeting_prep_agent_multi.py

# 5. Update REASONING_ENGINE with the output resource name from step 4

# 6. Create AgentSpace authorization:
#    ./scripts/create_authorization.sh

# 7. Register agent in AgentSpace:
#    ./scripts/create_agent.sh

# 8. Test in AgentSpace web interface at https://vertexaisearch.cloud.google.com/

# =============================================================================
# Important Notes for Multi-Agent System
# =============================================================================

# - PROJECT_NUMBER: gcloud projects describe PROJECT_ID --format="value(projectNumber)"
# - STAGING_BUCKET: Must be globally unique (suggest adding random suffix)
# - AUTH_ID: Must be unique and match across all tool files
# - REASONING_ENGINE: Set after successful deployment of meeting_prep_agent_multi.py
# - AS_APP: Filled automatically by create_agent.sh script
# - All OAuth scopes must be added to your OAuth consent screen
# - Test users must be added to OAuth consent screen during development
# - For detailed setup instructions, see: deployment_guide.md